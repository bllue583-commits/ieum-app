{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "한국어 raw-only local reliability trial candidate; not authenticated app output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "source_pack_sha256",
    "base_revision",
    "summary",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "source_pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "claims": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignee",
          "category",
          "certainty",
          "claim_id",
          "due",
          "due_expression",
          "evidence",
          "replaces",
          "status",
          "subject_id",
          "value"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "category": {
            "enum": [
              "context",
              "date",
              "document",
              "entity",
              "participant",
              "quantity",
              "request",
              "role",
              "status"
            ]
          },
          "subject_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "certainty": {
            "enum": [
              "explicit",
              "uncertain"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "start",
                "end",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          },
          "status": {
            "enum": [
              null,
              "done",
              "in_progress",
              "needs_confirmation",
              "open",
              "waiting"
            ]
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "due_expression": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "replaces": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
