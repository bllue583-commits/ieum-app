<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="com.kakao.talk" /></queries>
    <application>
        <activity android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity" android:exported="true" android:enabled="@bool/kakao_connection_enabled">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoNativeAppKey}" android:host="oauth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
