<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Text messages are read on the phone; the analysis keeps work ones and drops personal ones. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- The call log is matched with the recordings on the phone (number, direction, calls without a recording). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- v2.9: knows at once that a call ended, so its recording is looked for right away (design 6.1). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- v3.0: the call card over the call screen (design 7.2): drawn over other apps, kept alive during a call by a short
         foreground service (phoneCall, else specialUse). MANAGE_OWN_CALLS only makes the phoneCall type allowed; no call is made. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- v3.1 (DESIGN_V4 2.2-4): with this, Android 12+ installs our own update without a tap (session with
         USER_ACTION_NOT_REQUIRED, installs from this app allowed, targetSdk at the device's floor, no store owns updates).
         Missing any of these, Android asks once (STATUS_PENDING_USER_ACTION, kept as USER_ACTION_REQUIRED). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Registers the call pipeline again after a restart of the phone, without opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v3.5 (DESIGN_V5): KakaoTalk, for the Kakao login and the morning report "나에게 보내기" (the SDK lists it too). -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>
    <application android:name=".IeumApplication" android:allowBackup="false" android:fullBackupContent="@xml/vault_full_backup_rules"
        android:dataExtractionRules="@xml/vault_data_extraction_rules"
        android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config"
        android:label="이음" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/Theme.CallBrief">
        <!-- The only screen Activity (design G1): home, calls, check list, companies and settings are drawn inside it.
             singleTop: a notification tapped while the app is open comes to onNewIntent instead of stacking a second copy. -->
        <activity android:name=".pipeline.MainActivity" android:exported="true" android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v3.5 (DESIGN_V5 1절): the [이음에서 보기] button of the KakaoTalk morning report opens kakao<app key>://kakaolink
                 with screen and dayMs; r15-3 reads them into the screen. kakaonone when the build has no Kakao key. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${kakaoScheme}" android:host="kakaolink" />
            </intent-filter>
        </activity>
        <!-- v3.5 (DESIGN_V5 2.1-1): the Kakao login comes back to kakao<app key>://oauth. The class is the SDK's own
             (an AppCompatActivity through CustomTabLauncherActivity); lint cannot see that far into the library. -->
        <activity android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity" android:exported="true" tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${kakaoScheme}" android:host="oauth" />
            </intent-filter>
        </activity>
        <!-- v3.3 (DESIGN_V4 3.2-4): the hidden golden measurement, opened from 설정 "상태와 도움" only. -->
        <activity android:name=".pipeline.GoldenMeasureActivity" android:exported="false" android:screenOrientation="portrait" />
        <receiver android:name=".pipeline.UpdateStatusReceiver" android:exported="false" />
        <receiver android:name=".pipeline.NotificationActionReceiver" android:exported="false" />
        <!-- Exported: PHONE_STATE is sent by the system (design 6.1, r10-1). -->
        <receiver android:name=".pipeline.call.CallStateReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <!-- v3.0 (design 7.2, r11-1): the call card's service, only while a call rings or goes on. -->
        <service android:name=".pipeline.call.CallCardService" android:exported="false"
            android:foregroundServiceType="phoneCall|specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user's own notes about the caller over the call screen while a call rings or goes on." />
        </service>
        <!-- v3.0: the number of a call that goes out, with the optional call redirection role. Never redirects or cancels. -->
        <service android:name=".pipeline.call.OutgoingCallService" android:exported="true"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE" tools:targetApi="29">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>
        <receiver android:name=".pipeline.StartupReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
